{
  "name": "linkbot",
  "version": "1.0.0",
  "description": "A simple Discord bot written in javascript",
  "exports": "./index.js",
  "type": "module",
  "dependencies": {
    "@sentry/cli": "^2.52.0",
    "@sentry/node": "^10.5.0",
    "@types/node": "^24.3.0",
    "@types/node-cron": "^3.0.11",
    "chrono-node": "^2.8.4",
    "date-fns": "^4.1.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.1",
    "firebase": "^12.1.0",
    "node-cron": "^4.2.1",
    "normalize-url": "^8.0.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2"
  },
  "scripts": {
    "start": "npm run build && node build",
    "build": "tsc && npm run sentry:sourcemaps",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org kwarkbit --project linkbot ./build && sentry-cli sourcemaps upload --org kwarkbit --project linkbot ./build"
  },
