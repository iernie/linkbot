{
  "name": "linkbot",
  "version": "1.0.0",
  "description": "A simple Discord bot written in javascript",
  "exports": "./index.js",
  "type": "module",
  "dependencies": {
    "@sentry/cli": "^3.2.3",
    "@sentry/node": "^10.41.0",
    "@types/node": "^25.3.3",
    "@types/node-cron": "^3.0.11",
    "chrono-node": "^2.9.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "firebase": "^12.10.0",
    "node-cron": "^4.2.1",
    "normalize-url": "^9.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1"
  },
  "scripts": {
    "start": "npm run build && node build",
    "build": "tsc && npm run sentry:sourcemaps",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org kwarkbit --project linkbot ./build && sentry-cli sourcemaps upload --org kwarkbit --project linkbot ./build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iernie/linkbot.git"
  },
  "author": "iernie",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iernie/linkbot/issues"
  },
  "homepage": "https://github.com/iernie/linkbot#readme",
  "engines": {
    "node": ">= 22.0.0"
  }
}
