{
  "name": "linkbot",
  "version": "1.0.0",
  "description": "A simple Discord bot written in javascript",
  "exports": "./index.js",
  "type": "module",
  "dependencies": {
    "@sentry/cli": "^3.7.0",
    "@sentry/node": "^10.73.0",
    "@types/node": "^26.4.0",
    "@types/node-cron": "^3.0.11",
    "chrono-node": "^2.10.1",
    "date-fns": "^4.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.18.0",
    "node-cron": "^4.6.0",
    "normalize-url": "^9.0.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "start": "npm run build && node build",
    "build": "tsc && npm run sentry:sourcemaps",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org kwarkbit --project linkbot ./build && sentry-cli sourcemaps upload --org kwarkbit --project linkbot ./build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iernie/linkbot.git"
  },
  "author": "iernie",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iernie/linkbot/issues"
  },
  "homepage": "https://github.com/iernie/linkbot#readme",
  "engines": {
    "node": ">= 22.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@sentry/cli@3.7.0": true,
    "protobufjs": false
  }
}
